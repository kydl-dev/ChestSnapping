<Project Sdk="Microsoft.NET.Sdk">
  <!--
    ChestSnapping mod. Everything shared by the user's mods (references from E:\Projects\Valheim\Claude\ref, net48, no debug symbols,
    the shared code Kydl.Common / Kydl.Ui, copy to Assets + build, embedded bundle) comes from Claude\shared\Kydl.Mod.props / .targets.
    Add here only what is special about this mod (an extra reference: put the DLL into Claude\ref and add a line below).
    Build: dotnet build "ChestSnapping-Mod\ChestSnapping.csproj" -c Release
  -->
  <Import Project="..\..\Claude\shared\Kydl.Mod.props" />

  <PropertyGroup>
    <AssemblyName>ChestSnapping</AssemblyName>
    <RootNamespace>ChestSnapping</RootNamespace>
    <PackageId>ChestSnapping</PackageId>
    <!-- AssetBundle built by the Unity project (Valheim > Build AssetBundles); embedded into the DLL when Assets\chestsnapping exists -->
    <BundleName>chestsnapping</BundleName>
    <!-- 2.0.0: the UI kit, the input lock and the KY hub come from KydlCore.dll (a hard dependency), not from a copy in this DLL -->
    <KydlUseCore>true</KydlUseCore>
    <!-- spec layout (MIGRATION_DECISIONS A8): the DLL goes to assets\ only, no build\ folder -->
    <KydlBuildFolder>false</KydlBuildFolder>
  </PropertyGroup>

  <ItemGroup>
    <!-- tests\ (NUnit + TestLab suites), docs\ and release\ live inside this folder but are never part of the mod (spec 3: excluded from the release) -->
    <Compile Remove="tests\**;docs\**;release\**" />
    <None Remove="tests\**;docs\**;release\**" />
    <EmbeddedResource Remove="tests\**;docs\**;release\**" />
  </ItemGroup>


  <Import Project="..\..\Claude\shared\Kydl.Mod.targets" />
</Project>
