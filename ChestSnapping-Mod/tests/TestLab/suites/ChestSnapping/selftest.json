{
  "name": "selftest",
  "description": "ChestSnapping's own in-game checks pass (built-in chest prefabs exist, the wood chest has a measurable box)",
  "timeout": 60,
  "steps": [
    { "do": "hook", "name": "chestsnapping.arena", "contains": "arena at", "label": "start on the arena spot" },
    { "do": "wait", "seconds": 6 },
    { "do": "hook", "name": "chestsnapping.selftest", "notContains": "FAIL", "contains": "PASS" }
  ],
  "asserts": [
    { "check": "noErrors", "source": "ChestSnapping" }
  ]
}