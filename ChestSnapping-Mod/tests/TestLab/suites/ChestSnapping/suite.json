  "requireMods": [
    { "guid": "com.kydldev.ChestSnapping", "minVersion": "2.0.0" },
    { "guid": "com.kydldev.KydlCore", "minVersion": "1.0.0" }
  ],
  "configOverrides": [
    { "guid": "com.kydldev.ChestSnapping", "section": "General", "key": "EnableAll", "value": "true" },
    { "guid": "com.kydldev.ChestSnapping", "section": "Prefabs", "key": "Enable", "value": "true" },
    { "guid": "com.kydldev.ChestSnapping", "section": "Prefabs", "key": "ExtraPrefabs", "value": "" },
    { "guid": "com.kydldev.ChestSnapping", "section": "Prefabs", "key": "ExcludedPrefabs", "value": "" },
    { "guid": "com.kydldev.ChestSnapping", "section": "Prefabs", "key": "AutoDetectContainers", "value": "false" },
    { "guid": "com.kydldev.ChestSnapping", "section": "Offsets", "key": "Enable", "value": "true" },
    { "guid": "com.kydldev.ChestSnapping", "section": "Offsets", "key": "PrefabAdjustments", "value": "" },
    { "guid": "com.kydldev.ChestSnapping", "section": "DebugLog", "key": "Enable", "value": "true" }
